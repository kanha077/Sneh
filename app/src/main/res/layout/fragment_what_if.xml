<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snehCream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What-If Simulator"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/snehDeep"
            android:layout_marginBottom="16dp"/>

        <!-- DESCRIPTION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scenario Predictor 🔮"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simulate how lifestyle changes (stress, sleep, meals) will affect your hormone levels and energy during your active cycle phase."
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/snehText"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PRESETS GRID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a Preset Scenario"
            android:textSize="10sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/snehDeep"
            android:layout_marginBottom="8dp"/>

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:alignItems="stretch"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/presetSkipMeals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skip Meals 🍽️"
                android:textSize="9sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/calendarBrown"
                android:background="@drawable/bg_task_pending"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/presetSleep5h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleep 5 hours 😴"
                android:textSize="9sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/calendarBrown"
                android:background="@drawable/bg_task_pending"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/presetHighStress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High Stress ⚡"
                android:textSize="9sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/calendarBrown"
                android:background="@drawable/bg_task_pending"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"/>

        </com.google.android.flexbox.FlexboxLayout>

        <!-- SIMULATOR PREDICTION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/predictionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/snehRose"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtPredictionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Prediction Results"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtPredictionBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hormone predictions based on the simulated scenario."
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/snehText"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/txtHormoneScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simulated Wellness Score: 85/100"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehRose"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
