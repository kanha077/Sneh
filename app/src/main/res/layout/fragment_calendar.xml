<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/snehCream"
    android:padding="16dp">

    <!-- CALENDAR CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/snehWhite"
        app:strokeWidth="1dp"
        app:strokeColor="@color/snehBlush"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Month & Year Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="@color/snehRose"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/txtMonthYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="June 2026"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"/>

                <TextView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/snehRose"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"/>

            </RelativeLayout>

            <!-- Days of Week Label Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mon" android:textSize="10sp" android:fontFamily="@font/poppins_bold" android:textColor="@color/snehMuted" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tue" android:textSize="10sp" android:fontFamily="@font/poppins_bold" android:textColor="@color/snehMuted" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wed" android:textSize="10sp" android:fontFamily="@font/poppins_bold" android:textColor="@color/snehMuted" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Thu" android:textSize="10sp" android:fontFamily="@font/poppins_bold" android:textColor="@color/snehMuted" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fri" android:textSize="10sp" android:fontFamily="@font/poppins_bold" android:textColor="@color/snehMuted" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sat" android:textSize="10sp" android:fontFamily="@font/poppins_bold" android:textColor="@color/snehMuted" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sun" android:textSize="10sp" android:fontFamily="@font/poppins_bold" android:textColor="@color/snehMuted" android:gravity="center"/>
            </LinearLayout>

            <!-- Calendar Days Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendarRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Legends -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="12dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_period"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Period"
                    android:textSize="9sp"
                    android:textColor="@color/snehText"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginEnd="16dp"/>

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_fertility"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fertility Window"
                    android:textSize="9sp"
                    android:textColor="@color/snehText"
                    android:fontFamily="@font/poppins_regular"/>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- SYMPTOM LOGGING CARD -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtSelectedDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logs for June 11, 2026"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log Period Start Date"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehText"
                    android:layout_marginBottom="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetPeriodStart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Mark this day as Period Start"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehRose"
                    app:strokeColor="@color/snehRose"
                    app:cornerRadius="22dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Symptom Checklist"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehText"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:alignItems="stretch"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/chipCramps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cramps ⚡"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/calendarBrown"
                        android:background="@drawable/bg_task_pending"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_margin="3dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipHeadache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Headache 🤕"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/calendarBrown"
                        android:background="@drawable/bg_task_pending"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_margin="3dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipFatigue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fatigue 😴"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/calendarBrown"
                        android:background="@drawable/bg_task_pending"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_margin="3dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipMood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mood Swings 🎭"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/calendarBrown"
                        android:background="@drawable/bg_task_pending"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_margin="3dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipBloating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bloating 🎈"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/calendarBrown"
                        android:background="@drawable/bg_task_pending"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_margin="3dp"
                        android:clickable="true"
                        android:focusable="true"/>

                </com.google.android.flexbox.FlexboxLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Save Symptoms"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/snehRose"
                    app:cornerRadius="22dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

</LinearLayout>
