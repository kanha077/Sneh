<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snehCream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fertility Plan"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/snehDeep"
            android:layout_marginBottom="16dp"/>

        <!-- CONCEPTION CHANCE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtFertileChance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium Chance"
                    android:textSize="22sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehRose" />

                <!-- Countdown Ring Visual representation -->
                <RelativeLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/fertilityCountdownProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        app:indicatorSize="110dp"
                        app:trackThickness="8dp"
                        app:trackColor="@color/snehBlush"
                        app:indicatorColor="@color/snehRose"
                        android:max="28"
                        android:progress="14" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtDaysToOvulation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textSize="24sp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/snehDeep" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="days to peak"
                            android:textSize="9sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/snehMuted" />

                    </LinearLayout>

                </RelativeLayout>

                <TextView
                    android:id="@+id/txtFertilityTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep tracking daily basal temperature for higher accuracy."
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/snehSubtle"
                    android:gravity="center"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- FERTILITY CHECKLIST CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preconception Wellness Tasks"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="12dp"/>

                <!-- Task 1: Folic acid -->
                <LinearLayout
                    android:id="@+id/taskFolic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/imgFolicCheck"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_circle_outline"
                        android:layout_marginEnd="12dp"
                        app:tint="@color/snehRose"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Take prenatal folic acid supplement"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/snehText"/>
                </LinearLayout>

                <!-- Task 2: BBT -->
                <LinearLayout
                    android:id="@+id/taskBBT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/imgBBTCheck"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_circle_outline"
                        android:layout_marginEnd="12dp"
                        app:tint="@color/snehRose"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Record Basal Body Temperature"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/snehText"/>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
