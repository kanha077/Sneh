<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snehCream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physician Report"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share directly with your doctor"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/snehMuted"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="GEMINI"
                android:textSize="8sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:background="@color/snehRose"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>

        </RelativeLayout>

        <!-- SUBTEXT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/snehBlush"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Ready for your Ob-Gyn appointment"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/snehDeep"
                android:gravity="center"
                android:padding="12dp"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- MEDICAL SUMMARY VALUES CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health Summary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="16dp"/>

                <!-- Row 1: Avg Cycle Length -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average cycle length"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/snehText"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:id="@+id/txtReportCycleLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28 days"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/snehRose"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <!-- Row 2: Period Duration -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Period duration"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/snehText"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:id="@+id/txtReportPeriodDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 days"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/snehRose"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <!-- Row 3: Common Symptoms -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Common symptoms"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/snehText"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:id="@+id/txtReportSymptoms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cramps, Fatigue"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/snehRose"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <!-- Row 4: Mood pattern -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mood pattern"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/snehText"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:id="@+id/txtReportMood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PMS mood swings"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/snehRose"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <!-- Row 5: Avg water intake -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg water intake"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/snehText"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:id="@+id/txtReportWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6.2 glasses/day"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/snehRose"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CTA EXPORT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportReport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📤 Export Medical PDF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/snehRose"
            app:cornerRadius="24dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>
