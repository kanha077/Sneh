<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snehCream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mind Wellness"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/snehDeep"
            android:layout_marginBottom="16dp"/>

        <!-- MOOD SELECTOR CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtMoodTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How is your mood today?"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/moodHappy"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:text="😊"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <TextView
                        android:id="@+id/moodCalm"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:text="😌"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <TextView
                        android:id="@+id/moodSad"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:text="😔"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <TextView
                        android:id="@+id/moodStressed"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:text="😠"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtLoggedMood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No mood logged today"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/snehSubtle"
                    android:layout_gravity="center_horizontal"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- GUIDED MEDITATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guided Meditation Session"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wind down with this 8-minute calming breath session designed for your active cycle phase."
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/snehText"
                    android:layout_marginBottom="14dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/txtTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="08:00"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/snehRose"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayMeditation"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:text="Start Session"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/snehRose"
                        app:cornerRadius="20dp"/>

                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PHASE SESSIONS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/snehWhite"
            app:strokeWidth="1dp"
            app:strokeColor="@color/snehBlush">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phase-Specific Audios"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/snehDeep"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎶"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cramps Relief Frequency"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/snehText"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 mins • Solfeggio soundscape"
                            android:textSize="9sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/snehSubtle"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎶"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estrogen Boosting Morning Beat"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/snehText"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 mins • High energy frequency"
                            android:textSize="9sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/snehSubtle"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
